---
import Layout from "../../layouts/Base.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <h4>Writing</h4>
  <ul class="posts">
    {
      posts.map((post) => (
        <li class="post">
          <a class="post__link" href={`/blog/${post.id}/`}>
            <h3 class="post__title as-f7">{post.data.title}</h3>
            <div class="post__tags">
              {post.data.tags.map((tag) => (
                <span class="post__tag">{tag}</span>
              ))}
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>

<style>
  .posts {
    display: flex;
    flex-direction: column;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post__link {
    text-decoration: none;
  }

  .post__title {
    position: relative;
    width: fit-content;
  }

  .post__title::before {
    content: "";
    display: block;
    background: rgba(255, 255, 255, 0.6);
    opacity: var(--scroll-progress, 1);
    position: absolute;
    top: var(--decorative-line-offset);
    right: 100%;
    height: 1px;
    margin-right: var(--decorative-line-gutter);
    width: calc(var(--logo-width) * 0.5 + var(--inner-spacing) - 1px - 20px);
  }

  .post__link:hover .post__title {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .post__tags {
    display: flex;
    gap: 8px;
    margin: 4px 0;
  }

  .post__tag {
    font: var(--font-scale-f1);
    background: #1b1b1a;
    color: #fff;
    padding: 2px 8px 6px 8px;
    line-height: 1;
  }
</style>
