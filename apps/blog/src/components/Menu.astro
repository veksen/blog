---
import MenuLink from "./MenuLink.astro";
---

<nav>
  <MenuLink href="/">About me</MenuLink>
  <MenuLink disabled href="/blog">Writing</MenuLink>
  <MenuLink disabled href="/projects">Projects</MenuLink>
  <MenuLink disabled href="/photography">Photography</MenuLink>
</nav>

<style>
  nav {
    margin-left: calc(var(--logo-width) + var(--inner-spacing));
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 20px;

    @media screen and (max-width: 768px) {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
