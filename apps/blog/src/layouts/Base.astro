---
import BaseHead from "../components/BaseHead.astro";
import Menu from "../components/Menu.astro";
import { Logo } from "@acme/ui/logo";

const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body>
    <div class="container">
      <div class="content">
        <header>
          <Logo />
          <Menu />
        </header>
        <main>
          <slot />
        </main>
      </div>
      <div class="structure">
        <div class="structure-inner">
          <img class="structure-image" src="./structure.jpg" alt="" />
        </div>
      </div>
    </div>
  </body>
</html>

<style>
  body {
    background-color: #121110;
    overflow: hidden;
    --outer-spacing: 64px;
    --logo-width: 104px;
    --inner-spacing: 40px;
    --structure-width: 315px;
  }
  .container {
    display: flex;
    margin-right: var(--structure-width);
  }
  .content {
    overflow-y: scroll;
    height: 100dvh;
    flex-grow: 1;
  }
  .content::-webkit-scrollbar {
    width: 13px;
    background: transparent;
  }
  .content::-webkit-scrollbar-track {
    background: transparent;
  }
  .content::-webkit-scrollbar-thumb {
    background: hsla(108, 7%, 73%, 0.45);
    border-radius: 4px;
  }
  .content::-webkit-scrollbar-thumb:hover {
    background: hsla(108, 7%, 73%, 0.65);
  }
  header {
    margin-top: var(--outer-spacing);
    padding: 0 var(--outer-spacing);
    display: flex;
    gap: var(--inner-spacing);
    align-items: center;
  }
  main {
    margin-left: calc(
      var(--outer-spacing) + var(--logo-width) + var(--inner-spacing)
    );
    margin-right: var(--outer-spacing);
    margin-bottom: var(--outer-spacing);
    margin-top: 44px;
    max-width: 770px;
  }
  .structure {
    overflow: hidden;
    position: fixed;
    width: var(--structure-width);
    border: 44px solid #b9c0b6;
    border-right: none;
    top: 0;
    right: 0;
    bottom: 0;
  }
  .structure-inner {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .structure-image {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    border-radius: 0;
    width: auto;
    min-width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    margin: 0;
  }
</style>
