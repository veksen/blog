---
import { BubblyBackground } from "@veksen/ui/bubbly-background";
import { Logo } from "@veksen/ui/logo";
import BaseHead from "../components/BaseHead.astro";
import Menu from "../components/Menu.astro";

const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body>
    <div class="container">
      <div class="content">
        <BubblyBackground className="bubbly-background" />
        <div class="content-inner">
          <header>
            <Logo />
            <Menu />
          </header>
          <main transition:animate="none">
            <slot />
          </main>
          <slot name="aside" />
        </div>
      </div>
      <div class="structure">
        <div class="structure-inner">
          <img class="structure-image" src="/structure.jpg" alt="" />
        </div>
      </div>
    </div>
    <style>
      body {
        background-color: #121110;
        overflow: hidden;
        --outer-spacing: 64px;
        --logo-width: 104px;
        --inner-spacing: 40px;
        --structure-width: 315px;
        --content-width: 770px;
        --decorative-line-offset: 50%;
        --decorative-line-gutter: 20px;
      }

      .bubbly-background {
        pointer-events: none;
        opacity: 0.05;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
      }

      .container {
        position: relative;
        display: flex;
        margin-right: var(--structure-width);
      }

      .content {
        overflow-y: scroll;
        height: 100dvh;
        flex-grow: 1;
      }

      .content-inner {
        margin-left: auto;
        margin-right: auto;
        max-width: calc(
          var(--content-width) + var(--outer-spacing) * 2 +
            var(--inner-spacing) + var(--logo-width)
        );
      }

      .content::-webkit-scrollbar {
        width: 13px;
        background: transparent;
      }

      .content::-webkit-scrollbar-track {
        background: transparent;
      }

      .content::-webkit-scrollbar-thumb {
        background: hsla(108, 7%, 73%, 0.45);
        border-radius: 4px;
      }

      .content::-webkit-scrollbar-thumb:hover {
        background: hsla(108, 7%, 73%, 0.65);
      }

      header {
        margin-top: var(--outer-spacing);
        padding: 0 var(--outer-spacing);
        display: flex;
        gap: var(--inner-spacing);
        align-items: center;
      }

      .logo {
        position: fixed;
      }

      .logo::before,
      .logo::after {
        content: "";
        display: block;
        background: #fff;
        opacity: 0.6;
        position: absolute;
        width: 1px;
        left: 50%;
        height: 100vh;
      }

      .logo::before {
        bottom: 100%;
        margin-bottom: var(--decorative-line-gutter);
      }

      .logo::after {
        top: 100%;
        margin-top: var(--decorative-line-gutter);
      }

      main {
        margin-left: calc(
          var(--outer-spacing) + var(--logo-width) + var(--inner-spacing)
        );
        margin-right: var(--outer-spacing);
        margin-bottom: var(--outer-spacing);
        margin-top: 44px;
        max-width: 770px;
      }

      .structure {
        overflow: hidden;
        position: fixed;
        width: var(--structure-width);
        border: 44px solid #b9c0b6;
        border-right: none;
        top: 0;
        right: 0;
        bottom: 0;
      }

      .structure-inner {
        position: relative;
        width: 100%;
        height: 100%;
      }

      .structure-image {
        position: absolute;
        top: 0;
        left: 0;
        bottom: 0;
        border-radius: 0;
        width: auto;
        min-width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top left;
        margin: 0;
      }
    </style>

    <script>
      const dissapearanceThresholdInPixels = 50;

      function getValue(scrollTop: number) {
        return Math.max(
          0,
          Math.min(1, scrollTop / dissapearanceThresholdInPixels)
        );
      }

      const content = document.querySelector(".content");

      content?.addEventListener("scroll", () => {
        const postTitle =
          document.querySelectorAll<HTMLElement>(".post__title");
        const logo = document.querySelector<HTMLElement>(".logo");

        if (logo && postTitle.length > 0) {
          const logoRect = logo.getBoundingClientRect();

          postTitle.forEach((postTitle) => {
            const rect = postTitle.getBoundingClientRect();
            const distanceFromLogo = rect.top - logoRect.bottom;
            const value = getValue(distanceFromLogo);
            postTitle.style.setProperty("--scroll-progress", value.toString());
          });
        }
      });
    </script>
  </body>
</html>
