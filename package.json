{
  "name": "veksen-blog",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md,js,jsx,json,astro,css,html}\"",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix"
  },
  "dependencies": {
    "@astrojs/react": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.13.0",
    "turbo": "^2.8.14"
  },
  "packageManager": "npm@11.9.0"
}
