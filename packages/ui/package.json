{
  "name": "@acme/ui",
  "version": "0.0.0",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    "./button": {
      "types": "./src/button.tsx",
      "import": "./dist/button.mjs",
      "require": "./dist/button.js"
    },
    "./logo": {
      "types": "./src/logo.tsx",
      "import": "./dist/logo.mjs",
      "require": "./dist/logo.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "eslint": "^8.57.0",
    "tsup": "^8.0.2",
    "typescript": "5.5.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
