{
  "name": "@veksen/ui",
  "version": "0.0.0",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    "./bubbly-background": {
      "types": "./src/bubbly-background.tsx",
      "import": "./dist/bubbly-background.mjs",
      "require": "./dist/bubbly-background.js"
    },
    "./button": {
      "types": "./src/button.tsx",
      "import": "./dist/button.mjs",
      "require": "./dist/button.js"
    },
    "./logo": {
      "types": "./src/logo.tsx",
      "import": "./dist/logo.mjs",
      "require": "./dist/logo.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@veksen/eslint-config": "*",
    "@veksen/typescript-config": "*",
    "eslint": "^8.57.0",
    "tsup": "^8.5.0",
    "typescript": "5.8.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
